#!/bin/bash
set -e

echo "=== Ubuntu Setup Script ==="

# --- 1. Custom Bash Prompt hinzufügen ---
BASHRC="$HOME/.bashrc"
PROMPT="PS1='\\[\\e[0;36m\\]:\\[\\e[1;32m\\]\\w\\[\\e[0;36m\\]\\$ \\[\\e[m\\]'"

if ! grep -Fxq "$PROMPT" "$BASHRC"; then
  echo "" >> "$BASHRC"
  echo "# Custom prompt added by setup_env.sh" >> "$BASHRC"
  echo "$PROMPT" >> "$BASHRC"
  echo "✅ Custom Bash-Prompt in ~/.bashrc eingetragen."
else
  echo "ℹ️ Custom Bash-Prompt ist bereits in ~/.bashrc vorhanden."
fi

# --- 2. Python & venv installieren ---
echo "=== Installiere Python und venv ==="
sudo apt update
sudo apt install -y python3 python3-venv python3-pip

# --- 3. Virtuelle Umgebung erstellen ---
VENV_DIR="$HOME/Code/venv"
mkdir -p "$HOME/Code"

if [ ! -d "$VENV_DIR" ]; then
  python3 -m venv "$VENV_DIR"
  echo "✅ Virtuelle Umgebung erstellt: $VENV_DIR"
else
  echo "ℹ️ Virtuelle Umgebung existiert bereits: $VENV_DIR"
fi

# --- 4. Virtuelle Umgebung aktivieren & Pakete installieren ---
echo "=== Aktiviere venv und installiere Pakete ==="
source "$VENV_DIR/bin/activate"

pip install --upgrade pip
pip install websocket-client numpy pandas stable-baselines3 d3rlpy

echo "✅ Alle Pakete installiert."

# --- 5. Abschluss ---
echo "=== Setup abgeschlossen ==="
echo "Aktiviere deine virtuelle Umgebung jederzeit mit:"
echo "source ~/Code/venv/bin/activate"
echo ""
echo "Starte eine neue Bash-Sitzung, um den neuen Prompt zu sehen."
